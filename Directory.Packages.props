<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Runtime dependencies">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Build / SourceLink">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.322" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup Label="Test dependencies">
    <!-- FluentAssertions pinned to the last MIT-licensed line; 8.x is commercial (Xceed). -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="WireMock.Net" Version="2.31.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <!--
      Why: WireMock.Net 2.11.0 has a transitive dependency on Scriban.Signed 7.2.0, which
      carries known moderate vulnerabilities (GHSA-6q7j-xr26-3h2c, GHSA-q6rr-fm2g-g5x8).
      Pin to 7.2.1 (the patched release) to satisfy NU1902 / TreatWarningsAsErrors.
    -->
    <PackageVersion Include="Scriban.Signed" Version="7.2.1" />
    <!--
      Why: WireMock.Net 2.11.0 also pulls Microsoft.AspNetCore.WebUtilities 2.3.0 transitively,
      affected by GHSA-6527-9fp8-r4x6 (patched in 2.3.14). Pin to the patched release to satisfy
      NU1902 / TreatWarningsAsErrors. Remove once WireMock.Net ships a fixed dependency.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
  </ItemGroup>

</Project>
