<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Runtime dependencies">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Build / SourceLink">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.341" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup Label="Test dependencies">
    <!-- FluentAssertions pinned to the last MIT-licensed line; 8.x is commercial (Xceed). -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="WireMock.Net" Version="2.31.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <!--
      Why: WireMock.Net pulls Scriban.Signed transitively, and Scriban versions up to 7.2.1
      carry known vulnerabilities (GHSA-6q7j-xr26-3h2c, GHSA-q6rr-fm2g-g5x8, GHSA-7jvp-hj45-2f2m)
      that fail NU1902 under TreatWarningsAsErrors. WireMock.Net 2.31.0 needs >= 7.5.3, so a
      lower central pin is a downgrade (NU1109). Pin to 7.6.1, the latest release, clear of
      all known advisories.
    -->
    <PackageVersion Include="Scriban.Signed" Version="7.6.1" />
    <!--
      Why: WireMock.Net 2.11.0 also pulls Microsoft.AspNetCore.WebUtilities 2.3.0 transitively,
      affected by GHSA-6527-9fp8-r4x6 (patched in 2.3.14). Pin to the patched release to satisfy
      NU1902 / TreatWarningsAsErrors. Remove once WireMock.Net ships a fixed dependency.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
  </ItemGroup>

</Project>
