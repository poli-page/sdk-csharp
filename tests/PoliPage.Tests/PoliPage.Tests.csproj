<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!--
      CS1591: tests don't need XML doc comments.
      CA1707: xUnit test method names use underscores by convention (Arrange_Act_Assert),
              which violates the no-underscores naming rule. Suppress in tests only.
      IDE1006: tests follow Method_state_expected naming even when async — the Async suffix
               rule (enforced for src/ in .editorconfig) makes test names unreadable.
      CA2026: newer SDKs (10.0.404+) flag JsonDocument.Parse(...).RootElement and suggest
              JsonElement.Parse, which does not exist on the net8.0 target. These are short-lived
              test assertions, so the undisposed document is harmless.
    -->
    <NoWarn>$(NoWarn);CS1591;CA1707;IDE1006;CA2026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API contract skip list (Contract/ContractFile.cs reads it next to the tests). -->
    <None Include="..\contract-skip.json" Link="contract-skip.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PoliPage\PoliPage.csproj" />
  </ItemGroup>

</Project>
